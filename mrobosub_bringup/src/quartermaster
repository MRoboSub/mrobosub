#!/usr/bin/env python

from enum import Enum
import time
import roslaunch
import rospkg
import rospy
from std_msgs.msg import Bool, Float64
from std_srvs.srv import SetBool, Trigger
from pathlib import Path
import warnings


USE_ML = True


class RobotState(Enum):
    ambient = 0
    ready = 1
    running = 2


rospy.init_node("quartermaster")

state = RobotState.ambient

rate = rospy.Rate(10)

led_strange_pub = rospy.Publisher("/led/strange", Bool, queue_size=1)
led_charm_pub = rospy.Publisher("/led/charm", Bool, queue_size=1)
led_on_pub = rospy.Publisher("/led/on", Bool, queue_size=1)

hall_effect_triggered = {"strange": False, "charm": False}
hall_effect_last_inputs = {"strange": False, "charm": False}

led_states = {"strange": False, "charm": False, "on": False}


def pub_strange_led(val: bool):
    led_strange_pub.publish(val)
    led_states["strange"] = val


def pub_charm_led(val: bool):
    led_charm_pub.publish(val)
    led_states["charm"] = val


def pub_on_led(val: bool):
    led_on_pub.publish(val)
    led_states["on"] = val


def pub_led(led: str, val: bool):
    print(f"setting {led} to {val}")
    if led == "strange":
        pub_strange_led(val)
    if led == "charm":
        pub_charm_led(val)
    if led == "on":
        pub_on_led(val)


pub_strange_led(False)
pub_charm_led(False)
pub_on_led(False)


rospack = rospkg.RosPack()
planning_pkg = Path(rospack.get_path("mrobosub_planning"))
capt_launch = None

rospy.wait_for_service("/thruster_mixing/enable")
enable_srv = rospy.ServiceProxy("/thruster_mixing/enable", SetBool)


def enable_thruster_mixing():
    enable_resp = enable_srv(True)
    retries = 0
    while not enable_resp.success and retries < 10:
        enable_resp = enable_srv(True)
        retries += 1
    rospy.loginfo(
        f"arming response: {enable_resp.success}; {enable_resp.message}; {retries} retries"
    )


rospy.wait_for_service("/localization/zero_state")
zero_srv = rospy.ServiceProxy("/localization/zero_state", Trigger)


def zero_state():
    zero_resp = zero_srv()
    retries = 0
    while not zero_resp.success and retries < 10:
        zero_resp = zero_srv()
        retries += 1
    rospy.loginfo(
        f"zero response: {zero_resp.success}; {zero_resp.message}; {retries} retries"
    )


if USE_ML:
    rospy.wait_for_service("/object_position/gate_red")


def set_strange(new_value: Bool):
    if not new_value.data and hall_effect_last_inputs["strange"]:
        hall_effect_triggered["strange"] = True
        print("strange changed")
    hall_effect_last_inputs["strange"] = new_value.data


def set_charm(new_value: Bool):
    if not new_value.data and hall_effect_last_inputs["charm"]:
        hall_effect_triggered["charm"] = True
        print("charm changed")
    hall_effect_last_inputs["charm"] = new_value.data


strange_sub = rospy.Subscriber("/buttons/strange", Bool, set_strange)
charm_sub = rospy.Subscriber("/buttons/charm", Bool, set_charm)

capt_launch = None
timeout_time = 0
timeout_disable = None

while not rospy.is_shutdown():
    pub_on_led(True)

    # KEEP THIS LINE
    rate.sleep()

    if rospy.get_time() < timeout_time:
        hall_effect_triggered = {"strange": False, "charm": False}
        continue

    if timeout_disable is not None:
        pub_led(timeout_disable, False)
        timeout_disable = None

    if not any(hall_effect_triggered.values()):
        continue

    timeout_time = rospy.get_time() + 5
    if hall_effect_triggered["strange"]:
        pub_strange_led(True)
        timeout_disable = "strange"
    elif hall_effect_triggered["charm"]:
        pub_charm_led(True)
        timeout_disable = "charm"

    hall_effect_triggered = {"strange": False, "charm": False}

    print(f"{led_states=}")

    if state == RobotState.ambient:
        enable_thruster_mixing()
        zero_state()

        state = RobotState.ready

    elif state == RobotState.ready:
        rospy.loginfo("starting state machine (from quartermaster)")
        uuid = roslaunch.rlutil.get_or_generate_uuid(None, False)
        roslaunch.configure_logging(uuid)
        capt_launch = roslaunch.parent.ROSLaunchParent(
            uuid, [str(planning_pkg / "launch" / "captain.launch")]
        )
        capt_launch.start()

        state = RobotState.running

    elif state == RobotState.running:
        soft_stop = rospy.ServiceProxy("/captain/soft_stop", Trigger)
        try:
            res = soft_stop()
        except:
            pass
        rospy.loginfo("Soft stopping state machine (from quartermaster)")

        if capt_launch is not None:
            capt_launch.shutdown()
            capt_launch = None
        else:
            warnings.warn(
                "Switching from running to ambient, but there is no capt_launch"
            )

        enable_thruster_mixing()

        state = RobotState.ambient

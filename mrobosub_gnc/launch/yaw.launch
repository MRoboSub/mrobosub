<launch>
  <node name="yaw_control" pkg="mrobosub_gnc" type="yaw_control.py">
  </node>
  <node name="yaw_pose_pid" ns="yaw_pose_pid" pkg="pid" type="controller">
    <rosparam command="load"  file="$(find mrobosub_gnc)/params/yaw_pose_pid.yaml" />
  </node>
  <node name="yaw_twist_pid" ns="yaw_twist_pid" pkg="pid" type="controller">
    <rosparam command="load"  file="$(find mrobosub_gnc)/params/yaw_twist_pid.yaml" />
   </node>
</launch>

<launch>
  <node name="pitch_control" pkg="mrobosub_gnc" exec="pid_dof_controller" args="pitch">
    <param from="$(find-pkg-share mrobosub_gnc)/params/pitch_control.yaml" />
  </node>
  <node name="pitch_pid" namespace="pitch_pid" pkg="jlb_pid" exec="controller_node">
    <param from="$(find-pkg-share mrobosub_gnc)/params/pitch_pid.yaml" />
  </node>
</launch>

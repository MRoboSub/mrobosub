<launch>
  <node name="heave_control" pkg="mrobosub_gnc" type="heave_control.py">
    <rosparam command="load" file="$(find mrobosub_gnc)/params/heave_control.yaml" />
  </node>
  <node name="heave_pose_pid" ns="heave_pose_pid" pkg="pid" type="controller">
    <rosparam command="load" file="$(find mrobosub_gnc)/params/heave_pose_pid.yaml" />
  </node>
  <node name="heave_twist_pid" ns="heave_twist_pid" pkg="pid" type="controller">
    <rosparam command="load" file="$(find mrobosub_gnc)/params/heave_twist_pid.yaml" />
  </node>
</launch>

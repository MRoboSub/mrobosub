<launch>
  <node name="roll_control" pkg="mrobosub_gnc" type="roll_control.py">
  </node>
  <node name="roll_pose_pid" ns="roll_pose_pid" pkg="pid" type="controller">
    <rosparam command="load"  file="$(find mrobosub_gnc)/params/roll_pose_pid.yaml" />
  </node>
  <node name="roll_twist_pid" ns="roll_twist_pid" pkg="pid" type="controller">
    <rosparam command="load"  file="$(find mrobosub_gnc)/params/roll_twist_pid.yaml" />
  </node>
</launch>

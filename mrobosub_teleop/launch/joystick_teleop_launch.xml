<launch>
  <!-- Continuous mode: push stick = move, release = stop -->
  <!-- Requires: ros2 run joy joy_node (or joy_linux) -->
  <node name="joystick_teleop" pkg="mrobosub_teleop" exec="joystick_teleop"
        output="screen">
    <param from="$(find-pkg-share mrobosub_teleop)/params/teleop_params.yaml"/>
  </node>
</launch>

#!/bin/bash

# Loop through all files ending with .launch in the current directory
for file in *.launch; do
    # Skip if no .launch files exist
    [ -e "$file" ] || continue

    # Extract the base name without extension
    base="${file%.launch}"

    # Construct the new filename
    new_name="${base}_launch.xml"

    # Rename the file
    mv "$file" "$new_name"

    echo "Renamed: $file → $new_name"
done